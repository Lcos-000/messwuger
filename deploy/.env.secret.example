# Campus Assistant 离线部署敏感配置模板
#
# 使用方式：
# 1. 复制本文件：cp deploy/.env.secret.example deploy/.env.secret
# 2. 填写下面所有必填项；不要直接使用空值或示例值
# 3. 建议执行：chmod 600 deploy/.env.secret
# 4. 执行 deploy/offline/build-and-export.sh 构建离线包
#
# deploy/.env.secret 不应提交到 Git。离线包构建脚本会把它复制到
# deploy/offline/package/.env.secret，供容器启动时读取。
#
# 数据库密码 MYSQL_ROOT_PASSWORD 位于 deploy/.env，不在本文件中配置。

# ==================== Java / Go 共享密钥 ====================
# JWT 签名密钥。Gateway、User-Service、Course-Service 必须使用同一值。
# 建议生成：openssl rand -hex 32
JWT_SECRET_KEY=

# AES 密钥。Java 与 Spider 必须使用同一值，长度必须为 16、24 或 32 字节。
# 建议生成：openssl rand -hex 16
# 该命令生成 32 个十六进制字符，作为字符串时满足 32 字节长度要求。
AES_SECRET_KEY=

# Java 内部回调鉴权 Token。User-Service、Course-Service、Spider 必须使用同一值。
# 建议生成：openssl rand -hex 32
JAVA_INTERNAL_TOKEN=

# Gateway 与后端服务之间的共享密钥。Gateway、User-Service 必须使用同一值。
# 建议生成：openssl rand -hex 32
GATEWAY_SECRET=

# Spider 任务 API Token。User-Service 调用 Spider 时使用，必须与 Spider 一致。
# 建议生成：openssl rand -hex 32
SPIDER_API_TOKEN=

# ==================== 外部服务凭据 ====================
# 云打码/验证码服务 Token。不能自行伪造，必须填写服务商提供的真实值。
YM_TOKEN=

# 阿里云 OSS。需要头像、背景、墙纸等上传功能时填写。
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_URL_PREFIX=
