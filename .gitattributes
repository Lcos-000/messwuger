# 强制 shell 脚本使用 LF 换行，避免 Windows CRLF 导致 Linux 执行失败
*.sh text eol=lf
*.bash text eol=lf

# 通用文本文件自动处理换行
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.conf text eol=lf
*.py text eol=lf
*.go text eol=lf
*.java text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.html text eol=lf
*.css text eol=lf
